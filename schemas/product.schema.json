{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curionest.local/schemas/product.schema.json",
  "title": "CurioNest product source",
  "type": "object",
  "required": ["title", "meta", "sections"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "meta": {
      "type": "object",
      "required": ["file_stem"],
      "properties": {
        "file_stem": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
      },
      "additionalProperties": true
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "vocabularyItem": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "array",
          "prefixItems": [
            { "type": "string", "minLength": 1 },
            { "type": "string", "minLength": 1 }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "section": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": [
            "header", "learning_objectives", "concept", "practice",
            "vocabulary", "figure", "assess_yourself", "lesson",
            "fill_blank", "data_table", "regents_practice", "review",
            "instructions", "quiz", "setup", "stations",
            "answer_sheet", "answer_key"
          ]
        },
        "title": { "type": "string" },
        "items": { "type": "array" },
        "image": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
